API_KEY=your_api_key
REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_PASSWORD=your_redis_password

# Market Data
FINNHUB_API=your_finnhub_api_key

# News Data
NEWSAPI_KEY=your_newsapi_key

# Database URL (psycopg2 dialect for PostgreSQL)
DB_URL=postgresql://postgres:your_postgres_password@localhost:5432/postgres
POSTGRES_PASSWORD=your_postgres_password

# Alpaca trading (paper=True for paper trading)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true

# Discord notifications (optional — leave blank to disable)
DISCORD_WEBHOOK_URL=

